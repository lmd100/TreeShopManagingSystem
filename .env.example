# Copy to .env and adjust if needed:
#   copy .env.example .env

# PostgreSQL (service name in compose: db)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=example
POSTGRES_DB=app
# Host port (container app still connects via db:5432 on Docker network)
POSTGRES_HOST_PORT=5433

# Backend — must match host port mapping and Vite proxy (Frontend/vite.config.js)
SERVER_PORT=8080

# Optional: override Spring datasource (defaults are built from POSTGRES_* above)
# SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/app
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=example

# JWT
JWT_SECRET=a-string-for-testing
JWT_LIFETIME=86400

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
